# /etc/diski9/diski9.env  (owner root:diski9, mode 0640, or 0600 owned by diski9)
# Template only: every value in <...> is a placeholder. Never commit the real file.
# Secrets belong only in the real file or the host's secret store.

# ---- environment and locations ------------------------------------------------
DISKI9_APP_ENVIRONMENT=production
# absolute path (the WSGI entry point refuses a relative one in production)
DISKI9_DATABASE_URL=sqlite:////var/lib/diski9/diski9.sqlite

# ---- competition database (hosted PostgreSQL; direct or session mode, port 5432) ----
DISKI9_APP_DATABASE_URL=postgresql+psycopg://<user>:<password>@<db-host>:5432/<database>
# the scheduler's lock connection: direct or session mode, never a transaction pooler
DISKI9_JOBS_DATABASE_URL=postgresql+psycopg://<user>:<password>@<db-host>:5432/<database>
DISKI9_JOBS_DATABASE_MODE=direct

# ---- accounts (hosted Supabase Auth; publishable key only, never the service key) ----
DISKI9_SUPABASE_AUTH_URL=https://<project-ref>.supabase.co/auth/v1
DISKI9_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
DISKI9_APP_SITE_URL=https://<site-name>
DISKI9_APP_TRUSTED_PROXIES=1
# generate with: diski9 account generate-keys
DISKI9_APP_SECRET_KEY=<generated-secret>
DISKI9_APP_TOKEN_ENCRYPTION_KEY=<generated-fernet-key>

# ---- API-Football (only when provider calls are approved; see SF-05) --------------
# DISKI9_API_FOOTBALL_KEY=<api-key>
DISKI9_API_FOOTBALL_DAILY_RESERVE=500

# ---- scheduler: SAFE DEFAULTS (do not change without owner approval) ---------------
DISKI9_JOBS_ENABLED=on
DISKI9_JOBS_STREAMS=beta
DISKI9_JOBS_PAUSE_FILE=/var/lib/diski9/PAUSED
DISKI9_JOBS_PROVIDER_CALLS=off
DISKI9_JOBS_MAX_REQUESTS_PER_TICK=10
DISKI9_JOBS_MAX_REQUESTS_PER_DAY=100
DISKI9_JOBS_PREPARE=off
DISKI9_JOBS_PREPARE_REFRESH=off

# ---- monitoring --------------------------------------------------------------------
DISKI9_OPS_TICK_INTERVAL_MINUTES=5
DISKI9_OPS_NOTIFY=off
# DISKI9_OPS_WEBHOOK_URL=<secret-webhook-url>   (not approved; leave unset)
# backup monitoring: an operator turns this on once backups and the off-host hook run
DISKI9_OPS_BACKUP_EXPECTED=off
DISKI9_OPS_BACKUP_WARNING_HOURS=26
DISKI9_OPS_BACKUP_CRITICAL_HOURS=50
DISKI9_OPS_RESTORE_DRILL_DAYS=35
