# Copy to .env for LOCAL development only. Never commit .env.
#
# In Claude Code Cloud the x-apisports-key header is injected by the environment's
# network proxy: leave DISKI9_API_FOOTBALL_KEY unset there.
# DISKI9_API_FOOTBALL_KEY=

DISKI9_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io/
DISKI9_API_FOOTBALL_TIMEOUT_SECONDS=30
DISKI9_API_FOOTBALL_MAX_RETRIES=3
DISKI9_API_FOOTBALL_BACKOFF_SECONDS=2
# Refuse new requests once the provider reports this many (or fewer) daily requests left.
DISKI9_API_FOOTBALL_DAILY_RESERVE=500
# Optional hard cap on requests per client instance.
# DISKI9_API_FOOTBALL_REQUEST_BUDGET=

# ---------------------------------------------------------------- competition backend
# PostgreSQL for the competition backend (Phase 6C). Placeholder values for local
# development only: choose your own password and never commit .env.
# docker compose reads the DISKI9_PG_* values.
DISKI9_PG_USER=diski9
DISKI9_PG_PASSWORD=change-me-local-only
DISKI9_PG_DATABASE=diski9
DISKI9_PG_PORT=5432
# development | test | production
DISKI9_APP_ENVIRONMENT=development
DISKI9_APP_DATABASE_URL=postgresql+psycopg://diski9:change-me-local-only@127.0.0.1:5432/diski9
# Used only by the automated tests; the database name must end in _test.
DISKI9_APP_TEST_DATABASE_URL=postgresql+psycopg://diski9:change-me-local-only@127.0.0.1:5432/diski9_test
# Optional tuning (defaults shown)
# DISKI9_APP_POOL_SIZE=5
# DISKI9_APP_MAX_OVERFLOW=5
# DISKI9_APP_STATEMENT_TIMEOUT_MS=15000
# DISKI9_APP_LOCK_TIMEOUT_MS=5000
